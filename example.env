# Local-only placeholders. Replace them in .env; never use these values in production.
POSTGRES_DB=atodotren
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-admin-password
ATODOTREN_WORKER_PASSWORD=replace-with-a-different-local-worker-password
POSTGRES_PORT=5432

# Host-side PostgreSQL wire URLs. URL-encode special characters in credentials.
DATABASE_URL=postgresql://atodotren_worker:replace-with-a-different-local-worker-password@localhost:5432/atodotren
MIGRATION_DATABASE_URL=postgresql://atodotren_migrator:replace-with-a-local-admin-password@localhost:5432/atodotren

NODE_ENV=development
LOG_LEVEL=info
DATABASE_SSL_MODE=disable
# DATABASE_CA_CERT_PATH=/absolute/path/to/provider-ca.pem
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DOCTOR_MAX_CLOCK_SKEW_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Integration tests create and remove a uniquely named disposable database on this local server.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:replace-with-a-local-admin-password@localhost:5432/atodotren
TEST_MIGRATOR_DATABASE_URL=postgresql://atodotren_migrator:replace-with-a-local-admin-password@localhost:5432/atodotren
TEST_WORKER_DATABASE_URL=postgresql://atodotren_worker:replace-with-a-different-local-worker-password@localhost:5432/atodotren
