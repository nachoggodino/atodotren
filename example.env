# Local-only placeholders. Replace them in .env; never use these values in production.
POSTGRES_DB=atodotren
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-admin-password
ATODOTREN_WORKER_PASSWORD=replace-with-a-different-local-worker-password
ATODOTREN_TELEGRAM_PASSWORD=replace-with-a-different-local-reporting-password
POSTGRES_PORT=5432

# Host-side PostgreSQL wire URLs. URL-encode special characters in credentials.
DATABASE_URL=postgresql://atodotren_worker:replace-with-a-different-local-worker-password@localhost:5432/atodotren
MIGRATION_DATABASE_URL=postgresql://atodotren_migrator:replace-with-a-local-admin-password@localhost:5432/atodotren
REPORT_DATABASE_URL=postgresql://atodotren_telegram:replace-with-a-different-local-reporting-password@localhost:5432/atodotren

NODE_ENV=development
LOG_LEVEL=info
DATABASE_SSL_MODE=disable
# DATABASE_CA_CERT_PATH=/absolute/path/to/provider-ca.pem
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DOCTOR_MAX_CLOCK_SKEW_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

# Static GTFS. The source URL defaults to RENFE when worker import-static is run
# without --url/--file. Temporary content is bounded and deleted after every run.
# GTFS_STATIC_TEMP_DIR=/var/tmp/atodotren-static
GTFS_STATIC_REQUIRED_LINE_CODES=
GTFS_STATIC_REQUIRED_STATION_IDS=

# GTFS-Realtime. Production defaults are the official RENFE protobuf endpoints.
GTFS_RT_TRIP_UPDATES_ENABLED=true
GTFS_RT_TRIP_UPDATES_URL=https://gtfsrt.renfe.com/trip_updates.pb
GTFS_RT_VEHICLE_POSITIONS_ENABLED=true
GTFS_RT_VEHICLE_POSITIONS_URL=https://gtfsrt.renfe.com/vehicle_positions.pb
GTFS_RT_SERVICE_ALERTS_ENABLED=true
GTFS_RT_SERVICE_ALERTS_URL=https://gtfsrt.renfe.com/alerts.pb
GTFS_RT_REQUEST_TIMEOUT_MS=10000
GTFS_RT_MAX_RESPONSE_BYTES=33554432
GTFS_RT_CYCLE_INTERVAL_MS=30000
GTFS_RT_ALERT_INTERVAL_MS=60000

# Isolated canonical/aggregate maintenance. Finalization retries inside this
# Madrid wall-clock window and never runs in the ingestion process.
MAINTENANCE_INTERVAL_MS=300000
MAINTENANCE_FINALIZE_AFTER=04:30
MAINTENANCE_FINALIZE_BEFORE=06:30

# Normalized outage queue. Compose mounts this volume read-only into telegram-ops
# for size/capacity reporting; the bot never writes the spool.
SQLITE_SPOOL_PATH=/tmp/atodotren/realtime-spool.sqlite
SQLITE_SPOOL_MAX_BYTES=1073741824
SQLITE_SPOOL_MAX_BACKLOG_MS=172800000
SQLITE_SPOOL_WARNING_RATIO=0.75

# Optional dead-man heartbeat. This remains worker-owned and is disabled for the pilot unless explicitly configured.
HEARTBEAT_URL=

# Milestone 5 private read-only Telegram operations bot. Numeric IDs must match
# the exact authorized private user/chat; no wildcard/group authorization exists.
TELEGRAM_OPERATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_PRIVATE_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_SECONDS=25
TELEGRAM_DIGEST_READY_TIME=04:00
TELEGRAM_DIGEST_TARGET_TIME=05:00
TELEGRAM_DIGEST_BLOCKED_TIME=06:30
TELEGRAM_REPORT_VERSION=pilot-v1
TELEGRAM_STATE_RETENTION_DAYS=45
TELEGRAM_CALLBACK_TTL_MS=600000
TELEGRAM_DATABASE_STATEMENT_TIMEOUT_MS=5000

# Telegram-service-only operational thresholds. Ingestion matching/malformed/stale
# detection continues to use the INGEST_* settings below.
TELEGRAM_ALERT_SPOOL_BACKLOG_MS=300000
TELEGRAM_ALERT_POSTGRES_CONSECUTIVE=3
TELEGRAM_ALERT_CPU_RATIO=0.90
TELEGRAM_ALERT_CPU_DURATION_MS=900000
TELEGRAM_ALERT_MEMORY_RATIO=0.85
TELEGRAM_ALERT_MEMORY_DURATION_MS=600000
TELEGRAM_ALERT_DISK_WARNING_RATIO=0.15
TELEGRAM_ALERT_DISK_CRITICAL_RATIO=0.08
TELEGRAM_ALERT_STATIC_AGE_DAYS=8

# Optional Pi host metrics. Leave disabled for portable deployments. When enabled,
# mount only narrowly scoped host /proc and root filesystem paths read-only into
# the container and point these variables at those in-container paths.
TELEGRAM_HOST_METRICS_ENABLED=false
TELEGRAM_HOST_PROC_PATH=
TELEGRAM_HOST_ROOT_PATH=

# Optional provider-neutral SMTP compatibility. Telegram delivery is owned only
# by telegram-ops; the ingestion worker does not receive Telegram credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

INGEST_ALERT_FAILURE_THRESHOLD=3
INGEST_STALE_AFTER_MS=120000
INGEST_MATCHING_RATE_MINIMUM=0.02
INGEST_MATCHING_RATE_RECOVERY_MINIMUM=0.05
INGEST_MATCHING_RECOVERY_THRESHOLD=3
INGEST_MALFORMED_RATE_MAXIMUM=0.25

# Integration tests create and remove a uniquely named disposable database on this local server.
TEST_ADMIN_DATABASE_URL=postgresql://postgres:replace-with-a-local-admin-password@localhost:5432/atodotren
TEST_MIGRATOR_DATABASE_URL=postgresql://atodotren_migrator:replace-with-a-local-admin-password@localhost:5432/atodotren
TEST_WORKER_DATABASE_URL=postgresql://atodotren_worker:replace-with-a-different-local-worker-password@localhost:5432/atodotren
TEST_TELEGRAM_DATABASE_URL=postgresql://atodotren_telegram:replace-with-a-different-local-reporting-password@localhost:5432/atodotren
